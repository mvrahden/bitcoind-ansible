## This file is managed by mvrahden/bitcoind-ansible. Do not edit it by hand:
## it is regenerated on every run and your changes will be lost.
##
## Bitcoin {{ 'Knots' if bitcoind_implementation == 'knots' else 'Core' }} v{{ bitcoind_version }} | network: {{ bitcoind_network }}
##
## Any option not exposed as a role variable can be set through bitcoind_config,
## which also overrides anything derived from the role variables. Options that
## apply per-network (bind, rpcbind, rpcport, addnode) come from
## bitcoind_network_config. See the role README for the full reference.
##
## Option documentation: https://github.com/bitcoin/bitcoin/blob/master/doc/bitcoin-conf.md
{#
   The configuration is assembled as a dictionary here rather than written out
   as literal lines, so that a single merge point governs precedence and every
   key is emitted exactly once. Duplicate keys in bitcoin.conf are a footgun:
   Bitcoin Core resolves them in ways that are easy to get wrong.
#}
{% set cfg = {
     'chain': bitcoind_network,
     'datadir': bitcoind_data_dir,
     'pid': '/run/bitcoind/' ~ bitcoind_network ~ '/bitcoind.pid',
     'server': bitcoind_server,
     'listen': bitcoind_listen,
     'disablewallet': bitcoind_disablewallet,
     'txindex': bitcoind_txindex,
     'whitelist': bitcoind_whitelist,
     'rpcauth': bitcoind_rpc_auth,
     'rpcallowip': bitcoind_rpc_allow_ips,
     'proxy': bitcoind_proxy,
   } %}
{% if bitcoind_use_onion %}
{% set _ = cfg.update({'onlynet': 'onion'}) %}
{% endif %}
{% if bitcoind_enable_zmq %}
{% set _ = cfg.update({
     'zmqpubrawblock': 'tcp://' ~ bitcoind_zmq_host ~ ':' ~ bitcoind_zmq_port_rawblock,
     'zmqpubrawtx': 'tcp://' ~ bitcoind_zmq_host ~ ':' ~ bitcoind_zmq_port_rawtx,
     'zmqpubhashblock': 'tcp://' ~ bitcoind_zmq_host ~ ':' ~ bitcoind_zmq_port_hashblock,
   }) %}
{% endif %}
{#
   Tor: listenonion needs access to Tor's control port, which the service unit
   grants via SupplementaryGroups. Without that the daemon starts fine but
   never publishes an onion address.
#}
{% if bitcoind_tor_enabled %}
{% set _ = cfg.update({'listenonion': true, 'torcontrol': bitcoind_tor_control}) %}
{% if not bitcoind_proxy %}
{% set _ = cfg.update({'proxy': bitcoind_tor_proxy}) %}
{% endif %}
{% endif %}
{% set netcfg = {
     'bind': bitcoind_bind,
     'rpcbind': bitcoind_rpc_bind,
     'rpcport': bitcoind_rpc_port,
     'addnode': bitcoind_nodes,
   } | combine(bitcoind_network_config) %}
{#
   bind, rpcbind, rpcport and addnode apply to mainnet unless placed in the
   matching [section], so for any other network they are emitted there instead.
#}
{% if bitcoind_network == 'main' %}
{% set cfg = cfg | combine(netcfg) %}
{% endif %}
{% set cfg = cfg | combine(bitcoind_config) %}
{% macro emit(items) %}
{% for key, value in items | dictsort %}
{% if value is boolean %}
{{ key }}={{ 1 if value else 0 }}
{% elif value is not string and value is iterable %}
{% for item in value %}
{% if item is not none and item | string | length > 0 %}
{{ key }}={{ item }}
{% endif %}
{% endfor %}
{% elif value is not none and value | string | length > 0 %}
{{ key }}={{ value }}
{% endif %}
{% endfor %}
{% endmacro %}
{{ emit(cfg) -}}
{% if bitcoind_network != 'main' %}

[{{ bitcoind_network }}]
{{ emit(netcfg) -}}
{% endif %}
